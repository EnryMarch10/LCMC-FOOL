let
    class Vector (x:int, y:int) {
        fun x:int() x;
        fun y:int() y;
        fun sum:Vector(other:Vector)
            if (other == null) then {
                null
            } else {
                new Vector(x + other.x(), y + other.y())
            };
    }

    fun main:int()
        let
            var v1:Vector = new Vector(10, 20);
            var v2:Vector = new Vector(4, 6);
            var vs: Vector = v1.sum(v2);
        in
            print(vs.x()) + print(vs.y());
in
    main();
