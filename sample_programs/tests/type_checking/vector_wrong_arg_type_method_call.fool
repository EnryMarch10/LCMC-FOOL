let
    class A () {
        fun hello:int() print(4);
    }

    class Vector (x:int, y:int) {
        fun getX:int() x;
        fun getY:int() y;
        fun sum:Vector(other:Vector)
            if (other == null) then {
                null
            } else {
                new Vector(x + other.getX(), y + other.getY())
            };
    }

    fun main:int()
        let
            var v1:Vector = new Vector(10, 20);
            var v2:Vector = new Vector(4, 6);
            var a:A = new A();
            var vs: Vector = v1.sum(a);
        in
            print(vs.getX()) + print(vs.getY());
in
    main(); /* Expected: 40 */
